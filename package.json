    "eslint-plugin-prettier": "^5.5.6",
    "express": "^4.22.3",
    "filenamify-url": "^1.0.0",
    "glob": "^7.2.3",
    "html2canvas-proxy": "^1.0.1",
    "jest": "^30.5.2",
    "jest-image-snapshot": "^6.5.2",
    "jquery": "^3.7.1",
    "js-polyfills": "^0.1.43",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-edge-launcher": "^0.4.2",
    "karma-firefox-launcher": "^2.1.3",
