  "scripts": {
    "prebuild": "node scripts/prepare-build.cjs",
    "build": "tsc --module commonjs -p tsconfig.build.json && rollup -c rollup.config.mjs && npm run build:create-reftest-list && npm run build:testrunner && npm run build:minify",
    "build:testrunner": "rollup -c tests/rollup.config.mjs",
    "build:minify": "uglifyjs --compress arrows=false --comments /^!/ -o dist/html2canvas.min.js --mangle -- dist/html2canvas.js",
    "build:reftest-result-list": "ts-node scripts/create-reftest-result-list.ts",
    "build:create-reftest-list": "ts-node scripts/create-reftest-list.ts tests/reftests/ignore.txt build/reftests.ts",
    "build:reftest-preview": "webpack --config www/webpack.config.js",
    "release": "standard-version",
    "format": "prettier --write \"{src,www/src,tests,scripts}/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "test": "npm run lint && npm run unittest && npm run karma",
    "unittest": "jest",
    "reftests-diff": "mkdirp tmp/snapshots && jest --roots=tests --testMatch=**/reftest-diff.ts",
    "karma": "ts-node tests/karma",
    "watch": "rollup -c rollup.config.mjs -w",
    "watch:unittest": "jest --watch",
    "start": "ts-node tests/server --port=8080 --cors=8081",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test:artifacts": "node --test scripts/artifacts.test.cjs",
    "test:rendering": "node scripts/rendering-equivalence.mjs",
    "test:tooling": "node --test scripts/legacy-dependencies.test.cjs",
    "test:legacy-browser": "node scripts/legacy-browser-smoke.cjs",
    "test:website-deps": "node --test scripts/website-dependencies.test.cjs",
    "test:website": "node scripts/website-equivalence.mjs"
  },
  "homepage": "https://html2canvas.hertzen.com",
  "license": "MIT",
  "dependencies": {
    "css-line-break": "^2.1.0",
    "text-segmentation": "^1.0.3"
  },
  "overrides": {
    "chromeless": {
      "chrome-launcher": "1.2.2",
      "chrome-remote-interface": "0.34.0"
    },
    "request": {
      "form-data": "2.5.6"
    }
  }
}
