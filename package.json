    "ts-jest": "^29.4.14",
    "ts-loader": "^8.4.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "uglify-js": "^3.19.3",
    "uglifyjs-webpack-plugin": "^2.2.0",
    "webpack": "^4.47.0",
    "webpack-cli": "^3.3.12",
